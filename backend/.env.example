# --- Blogger AI Automation: backend environment ---

# Server
HOST=127.0.0.1
PORT=8000

# Data
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/blogger_ai.db

# Ollama (local AI)
# OLLAMA_BASE_URL (or OLLAMA_URL) points at the Ollama server. Default localhost.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:1.5b

# Local auth: leave empty for localhost-only single-user.
# Set a value to require the X-Auth-Token header on every request.
LOCAL_AUTH_TOKEN=

# Encrypts Blogger OAuth tokens at rest (Phase 5). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# Blogger OAuth 2.0 (Phase 5) — create at https://console.cloud.google.com
# Credentials → OAuth 2.0 Client IDs → Desktop app type
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REDIRECT_URI=http://127.0.0.1:8000/api/blogger/callback
